# Optional overrides. Never commit real values.
# Copy this file to .env for local development.

# OAuth client ID from your ArcGIS Online or ArcGIS Enterprise organization.
# Overrides auth.appId in the active config.
VITE_ARCGIS_APP_ID=

# API key for ArcGIS location services. Required only when search.includeDefaultSources
# is true, or when a basemap uses a premium style id such as "streets-vector".
VITE_ARCGIS_API_KEY=
